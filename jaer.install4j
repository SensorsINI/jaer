    <entries>
      <dirEntry mountPoint="24" file="." overwriteMode="ifNewer" shared="true" overrideOverwriteMode="true" overrideUninstallMode="true" subDirectory="jaer" excludeSuffixes="*sources.jar,*javadoc.jar,*.java,*.tmp,*.form,*.orig,jaer-clone*,*.7z,*.code-workspace,hs_err*.log,*.pem,*.p12,*.pfx,*.keystore,*.jks">
        <exclude>
          <!-- Secrets / gitignored credentials. file="." packs the local tree; a missing
               exclude here ships Dropbox secrets in every local ant release. CI is safer
               only because these paths are not in git — still exclude them. -->
          <entry location="signpath" />
          <entry location=".signpath" />
          <entry location="install4j License key  2024-01-02 0834.txt" />
          <entry location="install4j_windows-x64_13_0_2.exe" />
          <!-- VCS / IDE / CI / editor — not needed to run jAER. .install4j is created by
               the installer at install time; do not exclude it. -->
          <entry location=".git" />
          <entry location=".github" />
          <entry location=".gitignore" />
          <entry location=".gitattributes" />
          <entry location=".classpath" />
          <entry location=".project" />
          <entry location=".settings" />
