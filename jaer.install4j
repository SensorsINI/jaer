          <!-- Prefer javacpp 1.5.10 (TensorFlow); drop leftover 1.4 from older Ivy resolves. -->
          <entry location="lib/javacpp-1.4.jar" />
          <!-- Safety net: OS TensorFlow natives (~70–150MB). Ivy no longer retrieves these;
