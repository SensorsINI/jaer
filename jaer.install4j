    <!-- 3.2.0: Temurin 21 LTS (21.0.12+8). Bump Adoptium bundle to JDK 25 in 3.2.1
         with the SignPath-signed Windows media — do not change 3.2.0 assets. -->
    <jreBundles jdkProviderId="Adoptium" release="21/jdk-21.0.12+8">
