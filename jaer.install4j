          </screen>
          <screen id="15" beanClass="com.install4j.runtime.beans.screens.InstallationScreen" rollbackBarrier="true" rollbackBarrierExitCode="0">
            <actions>
              <action id="17" beanClass="com.install4j.runtime.beans.actions.InstallFilesAction" actionElevationType="elevated" rollbackBarrierExitCode="0" failureStrategy="quit" errorMessage="${i18n:FileCorrupted}" />
              <!-- Upgrade leftover cleanup: excludes only skip packing new media; ifNewer leaves old jars.
                   Class is under actions.control (not misc) in install4j 13. -->
              <action id="50" beanClass="com.install4j.runtime.beans.actions.control.RunScriptAction" actionElevationType="elevated" rollbackBarrierExitCode="0">
                <serializedBean>
                  <property name="script">
                    <object class="com.install4j.api.beans.ScriptProperty">
                      <property name="value" type="string">File lib = new File(context.getInstallationDirectory(), "lib");
if (lib.isDirectory()) {
    String[] orphans = {
        "javacpp-1.4.jar",
        "tensorflow-core-platform-1.0.0-rc.2.jar",
        "tensorflow-core-native-1.0.0-rc.2-linux-arm64.jar",
        "tensorflow-core-native-1.0.0-rc.2-linux-x86_64.jar",
        "tensorflow-core-native-1.0.0-rc.2-macosx-arm64.jar",
        "tensorflow-core-native-1.0.0-rc.2-macosx-x86_64.jar",
        "tensorflow-core-native-1.0.0-rc.2-windows-x86_64.jar",
        "js-22.0.0.2.jar",
        "js-scriptengine-22.0.0.2.jar",
        "truffle-api-22.0.0.2.jar",
        "regex-22.0.0.2.jar",
        "graal-sdk-22.0.0.2.jar"
    };
    for (String name : orphans) {
        File f = new File(lib, name);
        if (f.isFile() &amp;&amp; f.delete()) {
            com.install4j.api.Util.logInfo(context, "Removed leftover " + f.getAbsolutePath());
        }
    }
    File[] scalaJunk = lib.listFiles((dir, n) -&gt; n.startsWith("scala") || n.startsWith("scalatest") || n.startsWith("scalactic") || n.startsWith("scalacheck") || n.equals("test-interface-1.0.jar"));
    if (scalaJunk != null) {
        for (File f : scalaJunk) {
            if (f.isFile() &amp;&amp; f.delete()) {
                com.install4j.api.Util.logInfo(context, "Removed leftover " + f.getAbsolutePath());
            }
        }
    }
    // Dropped Ivy deps: jblas, jhdf5, bytedeco hdf5, commons-math4, commons-net, mail, semver, jlfgr, uncommons-maths
    File[] ivyOrphans = lib.listFiles((dir, n) -&gt;
        n.startsWith("jblas") || n.startsWith("jhdf5") || n.startsWith("hdf5-")
        || n.startsWith("commons-math4") || n.startsWith("commons-net") || n.startsWith("ftpserver")
        || n.startsWith("javax.mail") || n.startsWith("mail-api") || n.startsWith("semver")
        || n.startsWith("jlfgr") || n.startsWith("uncommons-maths"));
    if (ivyOrphans != null) {
        for (File f : ivyOrphans) {
            if (f.isFile() &amp;&amp; f.delete()) {
                com.install4j.api.Util.logInfo(context, "Removed leftover " + f.getAbsolutePath());
            }
        }
    }
}
File jars = new File(context.getInstallationDirectory(), "jars");
if (jars.isDirectory()) {
    File[] djiJunk = jars.listFiles((dir, n) -&gt; n.startsWith("DJI RS4 Gimbal Controller"));
    if (djiJunk != null) {
        for (File f : djiJunk) {
            if (f.isFile() &amp;&amp; f.delete()) {
                com.install4j.api.Util.logInfo(context, "Removed leftover " + f.getAbsolutePath());
            }
        }
    }
    // Thesycon USBIO natives / jars/win32|win64 removed; see docs/WIP-USBIO-purge.md
    String[] usbioDllDirs = { "win32", "win64" };
    for (String sub : usbioDllDirs) {
        File dir = new File(jars, sub);
        File dll = new File(dir, "usbiojava.dll");
        if (dll.isFile() &amp;&amp; dll.delete()) {
            com.install4j.api.Util.logInfo(context, "Removed leftover " + dll.getAbsolutePath());
        }
        if (dir.isDirectory() &amp;&amp; dir.list() != null &amp;&amp; dir.list().length == 0 &amp;&amp; dir.delete()) {
            com.install4j.api.Util.logInfo(context, "Removed leftover " + dir.getAbsolutePath());
        }
    }
    // OpenNI2 / Kinect depth stack removed (StereoRecorder / depth viewer)
    File openni2 = new File(jars, "openni2");
    if (openni2.isDirectory()) {
        try {
            java.util.List&lt;java.nio.file.Path&gt; paths = java.nio.file.Files.walk(openni2.toPath())
                .sorted(java.util.Comparator.reverseOrder())
                .collect(java.util.stream.Collectors.toList());
            for (java.nio.file.Path p : paths) {
                java.nio.file.Files.deleteIfExists(p);
            }
            com.install4j.api.Util.logInfo(context, "Removed leftover " + openni2.getAbsolutePath());
        } catch (Exception ex) {
            com.install4j.api.Util.logInfo(context, "Could not remove " + openni2.getAbsolutePath() + ": " + ex);
        }
    }
}
File installRoot = context.getInstallationDirectory();
File nativeDir = new File(installRoot, "native");
java.util.List&lt;File&gt; leftoverTrees = new java.util.ArrayList&lt;File&gt;();
leftoverTrees.add(nativeDir);
// Secrets first. ifNewer never deletes paths dropped from new media.
leftoverTrees.add(new File(installRoot, "signpath"));
leftoverTrees.add(new File(installRoot, ".signpath"));
leftoverTrees.add(new File(installRoot, ".cursor"));
leftoverTrees.add(new File(installRoot, ".vscode"));
leftoverTrees.add(new File(installRoot, ".github"));
leftoverTrees.add(new File(installRoot, ".settings"));
leftoverTrees.add(new File(installRoot, ".idea"));
leftoverTrees.add(new File(installRoot, "src"));
leftoverTrees.add(new File(installRoot, "scripts"));
leftoverTrees.add(new File(installRoot, "bin"));
leftoverTrees.add(new File(installRoot, "tools"));
leftoverTrees.add(new File(installRoot, "images"));
leftoverTrees.add(new File(installRoot, "release-notes"));
leftoverTrees.add(new File(installRoot, "docs"));
leftoverTrees.add(new File(installRoot, "test"));
leftoverTrees.add(new File(installRoot, "nbproject"));
leftoverTrees.add(new File(installRoot, "packaging"));
leftoverTrees.add(new File(installRoot, "installers"));
leftoverTrees.add(new File(installRoot, "currentInstallers"));
leftoverTrees.add(new File(installRoot, "jaer-older-installers"));
leftoverTrees.add(new File(installRoot, "ivy"));
leftoverTrees.add(new File(installRoot, "tmp"));
leftoverTrees.add(new File(installRoot, "build"));
leftoverTrees.add(new File(installRoot, "dist/javadoc"));
leftoverTrees.add(new File(installRoot, "$" + "{build.dir}"));
leftoverTrees.add(new File(installRoot, "$" + "{build.generated.sources.dir}"));
for (File dir : leftoverTrees) {
    if (dir.isDirectory()) {
        try {
            java.util.List&lt;java.nio.file.Path&gt; paths = java.nio.file.Files.walk(dir.toPath())
                .sorted(java.util.Comparator.reverseOrder())
                .collect(java.util.stream.Collectors.toList());
            for (java.nio.file.Path p : paths) {
                java.nio.file.Files.deleteIfExists(p);
            }
            com.install4j.api.Util.logInfo(context, "Removed leftover " + dir.getAbsolutePath());
        } catch (Exception ex) {
            com.install4j.api.Util.logInfo(context, "Could not remove " + dir.getAbsolutePath() + ": " + ex);
        }
    }
}
String[] leftoverFiles = {
    "jaer.code-workspace", ".gitattributes", ".gitignore", ".classpath", ".project",
    "_ivy_report.xml", "_ivy_try.xml", "davis-color-renderer-benchmark.sh",
    "dvs-slice-avi-writer.exe", "dvs-slice-avi-writer.sh", "dvs-slice-avi-writer.exe4j",
    "jAERViewer_linux.sh", "jAERViewer_linux.xml", "jAERViewer_win64.exe", "jAERViewer.exe",
    "build.xml", "build.cmd", "ivy.xml", "ivysettings.xml", "jaer.install4j", "manifest.mf",
    "README-releasing-tagging.md", "dist/jAER.jar.7z"
};
for (String name : leftoverFiles) {
    File f = new File(installRoot, name);
    if (f.isFile() &amp;&amp; f.delete()) {
        com.install4j.api.Util.logInfo(context, "Removed leftover " + f.getAbsolutePath());
    }
}
File distDir = new File(installRoot, "dist");
if (distDir.isDirectory()) {
    File[] sevenZ = distDir.listFiles((d, n) -&gt; n.toLowerCase().endsWith(".7z"));
    if (sevenZ != null) {
        for (File f : sevenZ) {
            if (f.isFile() &amp;&amp; f.delete()) {
                com.install4j.api.Util.logInfo(context, "Removed leftover " + f.getAbsolutePath());
            }
        }
    }
}
File[] hsErr = installRoot.listFiles((d, n) -&gt; n.startsWith("hs_err") &amp;&amp; n.endsWith(".log"));
if (hsErr != null) {
    for (File f : hsErr) {
        if (f.isFile() &amp;&amp; f.delete()) {
            com.install4j.api.Util.logInfo(context, "Removed leftover " + f.getAbsolutePath());
        }
    }
}
File[] i4jSetup = installRoot.listFiles((d, n) -&gt;
    (n.startsWith("install4j_windows") &amp;&amp; n.toLowerCase().endsWith(".exe"))
    || n.startsWith("install4j License key"));
if (i4jSetup != null) {
    for (File f : i4jSetup) {
        if (f.isFile() &amp;&amp; f.delete()) {
            com.install4j.api.Util.logInfo(context, "Removed leftover " + f.getAbsolutePath());
        }
    }
}
return true;
</property>
                    </object>
                  </property>
                </serializedBean>
              </action>
