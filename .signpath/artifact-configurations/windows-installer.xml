<?xml version="1.0" encoding="utf-8"?>
<!--
  Paste/upload this into SignPath project "jaer" as artifact configuration slug: windows-installer
  Docs: https://docs.signpath.io/artifact-configuration/syntax
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <pe-file path="jAER_windows-x64_*.exe"
           product-name="jAER"
           product-version="${version}">
    <authenticode-sign />
  </pe-file>
</artifact-configuration>
