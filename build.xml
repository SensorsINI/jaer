<project name="jaer" default="default" basedir="." xmlns:ivy="antlib:org.apache.ivy.ant" xmlns:j2seproject3="http://www.netbeans.org/ns/j2se-project/3">
    

    <target depends="jar" description="Build jar.jar for all jAER classes." name="default"/>
    <description>Builds, tests, and runs the project jAER</description>
    <import file="nbproject/build-impl.xml"/>
    
    <!--Override default to replace target with release -->
<!--    <target depends="init,deps-jar,-pre-pre-compile" name="-do-compile-single">
        <fail unless="javac.includes">Must select some files in the IDE or set javac.includes</fail>
        <j2seproject3:force-recompile/>
        <j2seproject3:javac excludes="" gensrcdir="${build.generated.sources.dir}" includes="${javac.includes}, module-info.java" sourcepath="${src.dir}"/>
    </target>-->


    <target name="-do-clean" depends="init,clean-ivy">
        <delete dir="${build.dir}" failonerror="false"/>
    </target>
    
    <!-- Ant propertyfile/download-deps refreshes the #Day, dd Mon yyyy ... header on line 1.
         Snapshot before Ivy, then after compile/jar restore the snapshot when lines 2+ are unchanged.
         Path must be set after init (build.dir is undefined at project parse time). -->
    <target name="-snapshot-project-properties" depends="init">
        <mkdir dir="${build.dir}"/>
        <copy file="${basedir}/nbproject/project.properties"
              tofile="${build.dir}/project.properties.ant-snapshot" overwrite="true"/>
    </target>

    <target name="-revert-project-properties-if-only-datestamp" depends="init">
        <available file="${build.dir}/project.properties.ant-snapshot"
                   property="project.properties.snapshot.exists"/>
        <antcall target="-do-revert-project-properties-if-only-datestamp"/>
    </target>

    <target name="-do-revert-project-properties-if-only-datestamp" if="project.properties.snapshot.exists">
        <loadfile property="project.properties.snapshot.body"
                  srcFile="${build.dir}/project.properties.ant-snapshot" encoding="UTF-8">
            <filterchain>
                <tokenfilter>
                    <replaceregex pattern="\r" replace=""/>
                </tokenfilter>
                <headfilter lines="-1" skip="1"/>
            </filterchain>
        </loadfile>
        <loadfile property="project.properties.current.body"
                  srcFile="${basedir}/nbproject/project.properties" encoding="UTF-8">
            <filterchain>
                <tokenfilter>
                    <replaceregex pattern="\r" replace=""/>
                </tokenfilter>
                <headfilter lines="-1" skip="1"/>
            </filterchain>
        </loadfile>
        <condition property="project.properties.only.datestamp.changed">
            <equals arg1="${project.properties.snapshot.body}"
                    arg2="${project.properties.current.body}"/>
        </condition>
        <antcall target="-restore-project-properties-snapshot"/>
        <antcall target="-keep-project-properties-because-body-changed"/>
    </target>

    <target name="-restore-project-properties-snapshot" if="project.properties.only.datestamp.changed">
        <copy file="${build.dir}/project.properties.ant-snapshot"
              tofile="${basedir}/nbproject/project.properties" overwrite="true"/>
        <echo message="Reverted nbproject/project.properties (Ant datestamp-only change)"/>
    </target>

    <target name="-keep-project-properties-because-body-changed" unless="project.properties.only.datestamp.changed">
        <echo message="nbproject/project.properties changed beyond the Ant datestamp (usually ivy.classpath); not reverting"/>
    </target>

    <!--
            https://blog.alejandrocelaya.com/2014/02/22/dependency-management-in-java-projects-with-ant-and-ivy/ 
        https://ant.apache.org/ivy/ 
        http://wiki.netbeans.org/FaqIvy 
        see ivy.xml 
     
    ivy download and configure adapated from https://gist.github.com/snipsnipsnip/3284453 
    -->
    <property name="ivy.install.version" value="2.5.2" />
    <property name="ivy.jar.dir" value="${basedir}/ivy" />
    <property name="ivy.cache.dir" value="${basedir}/ivy" />
    <property name="ivy.jar.file" value="${ivy.jar.dir}/ivy.jar" />
    <property name="ivy.lib" value="${basedir}/lib" />
    <property name="ivy.settings.location" value="${basedir}/ivysettings.xml" />
    
    <target name="-check-ivy">
        <echo message="ivy.lib=${ivy.lib}" />
        <available file="${ivy.jar.file}" property="ivy.skip.download"/>
        <mkdir dir="${ivy.lib}"/>
    </target>

    <target name="-download-ivy" unless="ivy.skip.download" depends="-check-ivy">
        <mkdir dir="${ivy.jar.dir}"/>
        <echo message="installing ivy..."/>
        <get src="https://repo1.maven.org/maven2/org/apache/ivy/ivy/${ivy.install.version}/ivy-${ivy.install.version}.jar"
             dest="${ivy.jar.file}" usetimestamp="true"/>
    </target>

    <target name="-load-ivy-tasks" depends="-download-ivy">
        <path id="ivy.lib.path">
            <pathelement location="${ivy.jar.file}"/>
        </path>
        <taskdef resource="org/apache/ivy/ant/antlib.xml" uri="antlib:org.apache.ivy.ant" classpathref="ivy.lib.path"/>

    </target>
    
    <target name="-post-init">
    </target>

    <target name="-post-compile">
        <antcall target="-revert-project-properties-if-only-datestamp"/>
    </target>

    <target name="-post-compile-single">
        <antcall target="-revert-project-properties-if-only-datestamp"/>
    </target>
    <!-- Build jaer module -->


    <target name="download-deps" depends="-load-ivy-tasks,-snapshot-project-properties"
            description="Download dependent libraries.">

        <!--<echo message="****** If you get dialog Artifactory Domain asking for user/pass hit Cancel button"/>-->
        <ivy:resolve file="ivy.xml"/>

        <!--note following pattern that must be used instead of ${ivy.lib} which does not work for unknown reason-->
        <ivy:retrieve pattern="lib/[artifact]-[revision](-[classifier]).[ext]" sync="true"/>
        <!--<echo message="Retrieve pattern=${ivy.retrieve.pattern}"/>-->
        <!--<ivy:retrieve/>-->
         
        <pathconvert property="ivy.classpath.computed" dirsep="/" pathsep=":">
            <path>
                <fileset dir="${ivy.lib}" includes="*.jar"/>
            </path>
            <map from="${basedir}/" to=""/>
            <map from="${basedir}\" to=""/>
        </pathconvert>

        <!-- propertyfile always rewrites the #datestamp header. Skip the write when
             the classpath string is unchanged so ant run/compile does not dirty git. -->
        <condition property="ivy.classpath.unchanged">
            <equals arg1="${ivy.classpath}" arg2="${ivy.classpath.computed}"/>
        </condition>
        <antcall target="-write-ivy-classpath-if-changed"/>
        <antcall target="-echo-ivy-classpath-unchanged"/>

        <antcall target="-revert-project-properties-if-only-datestamp"/>
    </target>

    <target name="-write-ivy-classpath-if-changed" unless="ivy.classpath.unchanged">
        <propertyfile file="${basedir}/nbproject/project.properties">
            <entry operation="=" key="ivy.classpath" value="${ivy.classpath.computed}"/>
        </propertyfile>
        <echo message="Updated ivy.classpath in nbproject/project.properties"/>
    </target>

    <target name="-echo-ivy-classpath-unchanged" if="ivy.classpath.unchanged">
        <echo message="ivy.classpath unchanged; not rewriting nbproject/project.properties"/>
    </target>

    <target name="clean-deps" description="Clean downloaded libraries.">
        <echo message="clean-deps: deleting ${ivy.lib}" />
        <delete dir="${ivy.lib}" failonerror="false" />
    </target>
    
    <target name="clean-ivy-cache" description="Clear ivy/ folder of all libraries."  depends="-load-ivy-tasks">
        <!--<ivy:cleancache />-->
        <echo message="Clearing ivy cache ${ivy.cache.dir} excluding ${ivy.jar.file}"/>
        <delete dir="${ivy.cache.dir}" failonerror="false" />
    </target>

    <target name="clean-ivy" depends="clean-deps" description="Clean ivy.">
        <!-- Do not clear ivy.classpath here: init loads it before download-deps on compile,
             and Ant properties are immutable once set, so an empty value breaks the first compile
             after clean. lib/*.jar paths stay valid once Ivy retrieve repopulates lib/. -->
    </target>

    <!--    <target name="-use-ivy-junit" depends="download-deps" unless="netbeans.home">
        <property name="libs.junit_4.classpath" value="${ivy.lib}/junit-4.10.jar"/>
    </target>-->
    
    <!-- Ivy hook for normal compile (overrides empty NetBeans placeholders in build-impl.xml). -->
    <target name="-pre-compile-ivy" depends="download-deps"/>
    <target name="-pre-compile" depends="-pre-compile-ivy"/>

    <target name="-pre-compile-single-ivy" depends="download-deps"/>
    <target name="-pre-compile-single" depends="-pre-compile-single-ivy"/>

    <!-- Same javac/copy as -do-compile but without -pre-compile (no Ivy). lib/ must exist; run download-deps after ivy.xml changes. -->
    <target depends="init,deps-jar,-pre-pre-compile,-copy-persistence-xml,-compile-depend" if="have.sources" name="-do-compile-without-ivy">
        <j2seproject3:javac gensrcdir="${build.generated.sources.dir}"/>
        <copy todir="${build.classes.dir}">
            <fileset dir="${src.dir}" excludes="${build.classes.excludes},${excludes}" includes="${includes}"/>
        </copy>
    </target>

    <target name="compile-fast"
            depends="init,deps-jar,-pre-pre-compile,-do-compile-without-ivy,-post-compile"
            description="Compile Java only without Ivy resolve/retrieve."/>

    <target name="compile-single-fast"
            depends="init,deps-jar,-verify-automatic-build,-pre-pre-compile,-do-compile-single,-post-compile-single"
            description="Compile selected files without Ivy resolve/retrieve."/>

    <!-- Fast JAR: store-only pack (jar cvfM0) avoids single-threaded DEFLATE; optional 7z if on PATH. -->
    <property name="jar.fast.7z.level" value="5"/>

    <target name="jar-fast"
            depends="init,compile-fast,-pre-pre-jar,-pre-jar,-fast-jar-prepare-manifest,-do-jar-fast,-fast-jar-7z"
            description="Build JAR with jar cvfM0; 7z-compress to dist/jAER.jar.7z when 7z is on PATH."/>

    <target name="-fast-jar-prepare-manifest"
            depends="-do-jar-create-manifest,-do-jar-copy-manifest,-do-jar-set-mainclass,-do-jar-set-profile,-do-jar-set-splashscreen">
        <mkdir dir="${build.classes.dir}/META-INF"/>
        <copy encoding="UTF-8" file="${tmp.manifest.file}" overwrite="true"
              tofile="${build.classes.dir}/META-INF/MANIFEST.MF"/>
    </target>

    <target name="-resolve-jar-tool" depends="init">
        <available file="${java.home}/bin/jar.exe" property="jar.tool" value="${java.home}/bin/jar.exe"/>
        <available file="${java.home}/bin/jar" property="jar.tool" value="${java.home}/bin/jar"/>
        <available file="${java.home}/../bin/jar.exe" property="jar.tool" value="${java.home}/../bin/jar.exe"/>
        <available file="${java.home}/../bin/jar" property="jar.tool" value="${java.home}/../bin/jar"/>
        <fail unless="jar.tool" message="jar tool not found under ${java.home} (expected bin/jar or bin/jar.exe)"/>
    </target>

    <target name="-do-jar-fast" depends="-resolve-jar-tool,-fast-jar-prepare-manifest">
        <echo message="Creating store-only JAR (jar cfM0): ${dist.jar}"/>
        <delete file="${dist.jar}" quiet="true"/>
        <exec executable="${jar.tool}" failonerror="true">
            <arg value="cfM0"/>
            <arg file="${dist.jar}"/>
            <arg value="-C"/>
            <arg file="${build.classes.dir}"/>
            <arg value="."/>
        </exec>
        <delete quiet="true">
            <fileset file="${tmp.manifest.file}"/>
        </delete>
        <echo message="Store-only JAR ready: ${dist.jar}"/>
        <echo message="Run: java -jar &quot;${dist.jar}&quot;"/>
    </target>

    <target name="-detect-sevenz" depends="checkos">
        <exec executable="7z" failifexecutionfails="false" failonerror="false"
              resultproperty="sevenz.result" outputproperty="sevenz.out" errorproperty="sevenz.err">
            <arg value="-h"/>
        </exec>
        <condition property="have.sevenz">
            <equals arg1="${sevenz.result}" arg2="0"/>
        </condition>
        <condition property="sevenz.executable" value="7z">
            <equals arg1="${sevenz.result}" arg2="0"/>
        </condition>
    </target>

    <target name="-detect-sevenz-win" depends="-detect-sevenz" if="isWindows" unless="have.sevenz">
        <exec executable="7z.exe" failifexecutionfails="false" failonerror="false"
              resultproperty="sevenz.result">
            <arg value="-h"/>
        </exec>
        <condition property="have.sevenz">
            <equals arg1="${sevenz.result}" arg2="0"/>
        </condition>
        <condition property="sevenz.executable" value="7z.exe">
            <equals arg1="${sevenz.result}" arg2="0"/>
        </condition>
    </target>

    <target name="-fast-jar-7z-compress" depends="-detect-sevenz,-detect-sevenz-win" if="have.sevenz">
        <property name="dist.jar.7z" value="${dist.jar}.7z"/>
        <delete file="${dist.jar.7z}" quiet="true"/>
        <echo message="7-Zip: ${dist.jar} -&gt; ${dist.jar.7z} (-mmt=on -mx=${jar.fast.7z.level})"/>
        <exec executable="${sevenz.executable}" failonerror="true">
            <arg value="a"/>
            <arg value="-t7z"/>
            <arg value="-mx=${jar.fast.7z.level}"/>
            <arg value="-mmt=on"/>
            <arg value="-y"/>
            <arg file="${dist.jar.7z}"/>
            <arg file="${dist.jar}"/>
        </exec>
    </target>

    <target name="-fast-jar-7z-skipped" depends="-detect-sevenz,-detect-sevenz-win" unless="have.sevenz">
        <echo message="7-Zip not on PATH (tried 7z and 7z.exe); uncompressed ${dist.jar} only"/>
    </target>

    <target name="-fast-jar-7z" depends="-fast-jar-7z-compress,-fast-jar-7z-skipped"/>

    <target name="-pre-init">
        <tstamp/>
    </target>

    <!-- makes sure that the build version is written to the jar -->
    <target name="-pre-jar" depends="jaer-setBuildVersion,jaer-copySplashImage" >
        <echo message="build.xml project opened"/>
        <echo> Having trouble building or running?
            See the jAER user forum at https://groups.google.com/forum/#!forum/jaer-users
        </echo>
    </target>

    <target name="checkos">
        <condition property="isWindows" value="true">
            <os family="windows" />
        </condition>
    </target>


    <!--    copy splash image to src tree so that it gets into main jar-->
    <target name="jaer-copySplashImage">
        <copy file="images/1024w/SplashScreen.png" todir="build/classes"/>
    </target>

    <!-- Windows/macOS/Linux launchers come from install4j (ant release / jaer.install4j).
         The old exe4j jAERViewer_win64.exe path was removed. -->

    <target name="-post-jar" depends="-revert-project-properties-if-only-datestamp">
    </target>


    <!-- builds a runtime archive for end users who don't want to develop -->
    <target name="jaer-runtime-archive" depends="jar">
        <tstamp/>
        <exec executable="git" outputproperty="git.tag">
            <arg value="describe"/>
            <arg value="--tags"/>
            <arg value="--abbrev=0"/>
        </exec>
        <echo message="Git tag is ${git.tag}"/>
        <echo message="Building jaer-runtime-${git.tag}.zip"/>
        <!--<delete file="../jaer-runtime-\*.zip" failonerror="false"/>-->
        <property name="runtimeZipFileName" value="../jaer-runtime-${git.tag}.zip"/>
        <zip destfile="${runtimeZipFileName}" level="9"
             comment="jAER runtime release - see https://jaerproject.org">
            <zipfileset prefix="jAER-runtime"
                        dir="."
                        excludes="**/*.zip, ivy/**, **/*.private, **/*.hprof, **/*.log, **/*.ncb, installers/**, .git/**, exe4j*/**"
                        defaultexcludes="false"
            />
        </zip>
    </target>

  


    <!-- builds a file with the output of svnversion that is used for the About dialogs -->
    <!--TODO fix to get rev info from git-->
    <target name="jaer-setBuildVersion" depends="init,-load-version">
        <tstamp/>
        <echo message="Making build version file ${buildversion.outputfile} - you can ignore any error ${line.separator}generated here since it will only affect the Help/About... dialog." />
        <delete file="${buildversion.outputfile}"/>
        <echo message="${jaer.version}${line.separator}" append="true" file="${buildversion.outputfile}" />
        <echo message="Built ${TODAY} at ${TSTAMP} by ${user.name}${line.separator}" append="true" file="${buildversion.outputfile}" />
        <echo message="os.name=${os.name}${line.separator}" append="true" file="${buildversion.outputfile}" />
        <echo message="os.version=${os.version}${line.separator}" append="true" file="${buildversion.outputfile}" />
        <echo message="java.version=${java.version}${line.separator}" append="true" file="${buildversion.outputfile}" />
        <echo message="java.vendor=${java.vendor}${line.separator}" append="true" file="${buildversion.outputfile}" />
        <echo message="&quot;:git describe&quot; output: " append="true" file="${buildversion.outputfile}" />
        <!-- run version command to get revision numnber -->
        <exec executable="git" failifexecutionfails="false" spawn="false" dir="${basedir}" output="${buildversion.outputfile}" append="true" searchpath="true">
            <arg line="describe --tags --abbrev=0"/>
        </exec>
        <echo message="${line.separator}" append="true" file="${buildversion.outputfile}" />
        <concat>
            <filelist dir="${basedir}" files="${buildversion.outputfile}"/>
        </concat>
    </target>

    <!-- Single source of truth: root VERSION.txt (e.g. 2.8.0). -->
    <target name="-load-version">
        <available file="${basedir}/VERSION.txt" property="jaer.version.file.exists"/>
        <fail unless="jaer.version.file.exists" message="VERSION.txt is missing at ${basedir}/VERSION.txt"/>
        <loadfile property="jaer.version" srcFile="${basedir}/VERSION.txt">
            <filterchain>
                <striplinebreaks/>
                <tokenfilter>
                    <trim/>
                </tokenfilter>
            </filterchain>
        </loadfile>
        <fail message="VERSION.txt is empty">
            <condition>
                <equals arg1="${jaer.version}" arg2=""/>
            </condition>
        </fail>
        <echo message="jAER version from VERSION.txt: ${jaer.version}"/>
    </target>

    <target name="-compile-splash-tool" depends="init">
        <mkdir dir="${build.dir}/tools"/>
        <javac srcdir="${basedir}/scripts"
               includes="GenerateSplashScreen.java"
               destdir="${build.dir}/tools"
               includeantruntime="false"
               release="11">
            <compilerarg value="-Xlint:-options"/>
        </javac>
    </target>

    <target name="generate-splash" depends="-load-version,-compile-splash-tool"
            description="Overlay jAER/version on images/SplashScreen.png into 1024w and 256h PNGs.">
        <available file="${basedir}/images/SplashScreen.png" property="jaer.splash.base.exists"/>
        <fail unless="jaer.splash.base.exists"
              message="Base splash missing: ${basedir}/images/SplashScreen.png (export text-free PNG from SplashScreen.pdf)"/>
        <mkdir dir="${basedir}/images/1024w"/>
        <mkdir dir="${basedir}/images/256h"/>
        <java classname="GenerateSplashScreen"
              classpath="${build.dir}/tools"
              fork="true"
              failonerror="true">
            <arg value="${basedir}/images/SplashScreen.png"/>
            <arg value="${jaer.version}"/>
            <arg value="${basedir}/images/1024w/SplashScreen.png"/>
            <arg value="${basedir}/images/256h/SplashScreen.png"/>
        </java>
    </target>

    <target name="-sync-install4j-version" depends="-load-version">
        <replaceregexp file="${basedir}/jaer.install4j"
                       match='(&lt;application\b[^&gt;]*\bversion=")[^"]*(")'
                       replace="\1${jaer.version}\2"
                       byline="true"/>
        <echo message="Synced jaer.install4j application version to ${jaer.version}"/>
    </target>

    <target name="-confirm-release" depends="-load-version">
        <input message="Release version is ${jaer.version} (from VERSION.txt). Proceed with splash, clean jar, and install4jc? [y/N]"
               addproperty="jaer.release.confirm"
               defaultvalue="n"/>
        <condition property="jaer.release.confirmed">
            <matches string="${jaer.release.confirm}" pattern="(?i)\s*y(es)?\s*"/>
        </condition>
        <fail unless="jaer.release.confirmed" message="Release cancelled (reply y or yes to proceed)."/>
    </target>

    <!-- Optional local license from signpath/install4j-license.txt (gitignored; GH Actions uses secret). -->
    <target name="-probe-install4j-license-local">
        <available file="${basedir}/signpath/install4j-license.txt"
                   property="jaer.install4j.license.file.exists"/>
        <condition property="jaer.install4j.license.file.usable">
            <and>
                <isset property="jaer.install4j.license.file.exists"/>
                <length file="${basedir}/signpath/install4j-license.txt" when="greater" length="0"/>
            </and>
        </condition>
    </target>

    <target name="-load-install4j-license-local" depends="-probe-install4j-license-local"
            if="jaer.install4j.license.file.usable">
        <loadfile property="jaer.install4j.license"
                  srcFile="${basedir}/signpath/install4j-license.txt">
            <filterchain>
                <striplinebreaks/>
                <tokenfilter>
                    <trim/>
                </tokenfilter>
            </filterchain>
        </loadfile>
        <echo message="Using install4j license from signpath/install4j-license.txt"/>
    </target>

    <target name="-require-install4j-project">
        <available file="${basedir}/jaer.install4j" property="jaer.install4j.exists"/>
        <fail unless="jaer.install4j.exists" message="jaer.install4j not found"/>
    </target>

    <target name="-run-install4jc-with-license"
            depends="-require-install4j-project,-load-version,-load-install4j-license-local"
            if="jaer.install4j.license">
        <exec executable="install4jc" failonerror="true" searchpath="true" dir="${basedir}">
            <arg value="--license=${jaer.install4j.license}"/>
            <arg value="--release=${jaer.version}"/>
            <arg value="${basedir}/jaer.install4j"/>
        </exec>
    </target>

    <target name="-run-install4jc-without-license"
            depends="-require-install4j-project,-load-version,-load-install4j-license-local"
            unless="jaer.install4j.license">
        <exec executable="install4jc" failonerror="true" searchpath="true" dir="${basedir}">
            <arg value="--release=${jaer.version}"/>
            <arg value="${basedir}/jaer.install4j"/>
        </exec>
    </target>

    <target name="-run-install4jc"
            depends="-run-install4jc-with-license,-run-install4jc-without-license"/>

    <!-- Windows-only media for SignPath CI (media set id 26 / type windows). No interactive confirm. -->
    <target name="-run-install4jc-windows-with-license"
            depends="-require-install4j-project,-load-version,-load-install4j-license-local"
            if="jaer.install4j.license">
        <exec executable="install4jc" failonerror="true" searchpath="true" dir="${basedir}">
            <arg value="--license=${jaer.install4j.license}"/>
            <arg value="--release=${jaer.version}"/>
            <arg value="--media-types=windows"/>
            <arg value="${basedir}/jaer.install4j"/>
        </exec>
    </target>

    <target name="-run-install4jc-windows-without-license"
            depends="-require-install4j-project,-load-version,-load-install4j-license-local"
            unless="jaer.install4j.license">
        <exec executable="install4jc" failonerror="true" searchpath="true" dir="${basedir}">
            <arg value="--release=${jaer.version}"/>
            <arg value="--media-types=windows"/>
            <arg value="${basedir}/jaer.install4j"/>
        </exec>
    </target>

    <target name="-run-install4jc-windows"
            depends="-run-install4jc-windows-with-license,-run-install4jc-windows-without-license"/>

    <!-- Copy install4j updates.xml from installers/<version>/ to repo root (auto-update descriptor). -->
    <macrodef name="jaer-copy-updates-xml">
        <sequential>
            <property name="jaer.updates.xml.source"
                      value="${basedir}/installers/${jaer.version}/updates.xml"/>
            <available file="${jaer.updates.xml.source}" property="jaer.updates.xml.source.exists"/>
            <fail unless="jaer.updates.xml.source.exists"
                  message="Missing ${jaer.updates.xml.source} — run ant release (or install4jc) first."/>
            <copy file="${jaer.updates.xml.source}"
                  tofile="${basedir}/updates.xml"
                  overwrite="true"/>
            <echo message="Copied ${jaer.updates.xml.source} -&gt; ${basedir}/updates.xml"/>
            <echo message="Commit and push updates.xml so install4j auto-update can see ${jaer.version}."/>
        </sequential>
    </macrodef>

    <target name="copy-updates-xml" depends="-load-version"
            description="Copy installers/VERSION/updates.xml to repo root (non-interactive).">
        <jaer-copy-updates-xml/>
    </target>

    <target name="offer-copy-updates-xml" depends="-load-version"
            description="Ask whether to copy installers/VERSION/updates.xml to repo root.">
        <property name="jaer.updates.xml.source"
                  value="${basedir}/installers/${jaer.version}/updates.xml"/>
        <available file="${jaer.updates.xml.source}" property="jaer.updates.xml.source.exists"/>
        <fail unless="jaer.updates.xml.source.exists"
              message="Missing ${jaer.updates.xml.source} — run ant release (or install4jc) first."/>
        <input message="Copy installers/${jaer.version}/updates.xml to repo root for auto-update? [y/N]"
               addproperty="jaer.copy.updates.confirm"
               defaultvalue="n"/>
        <condition property="jaer.copy.updates.confirmed">
            <matches string="${jaer.copy.updates.confirm}" pattern="(?i)\s*y(es)?\s*"/>
        </condition>
        <antcall target="-do-copy-updates-xml-if-confirmed"/>
    </target>

    <target name="-do-copy-updates-xml-if-confirmed" if="jaer.copy.updates.confirmed">
        <jaer-copy-updates-xml/>
    </target>

    <target name="release"
            depends="-load-version,-confirm-release,generate-splash,-sync-install4j-version,clean,jar,-run-install4jc,offer-copy-updates-xml"
            description="Confirm VERSION.txt, generate splash PNGs, sync install4j, clean/jar, run install4jc, offer updates.xml copy.">
        <echo message="${line.separator}install4j media build finished for ${jaer.version}."/>
        <echo message="Next: git tag ${jaer.version}, push updates.xml if copied, and create the GitHub release."/>
        <echo message="See README-releasing-tagging.txt"/>
    </target>

    <target name="release-windows-ci"
            depends="-load-version,generate-splash,-sync-install4j-version,clean,jar,-run-install4jc-windows"
            description="Non-interactive Windows-only install4j media for SignPath CI (no confirm prompt).">
        <echo message="${line.separator}Windows install4j media build finished for ${jaer.version}."/>
        <echo message="Output: installers/${jaer.version}/jAER_windows-x64_*.exe"/>
        <echo message="See README-releasing-tagging.txt (SignPath Windows CI)."/>
    </target>

    <target name="jaer-sign-jar" depends="jar">
        <echo message="Self-signing jar"/>
        <signjar jar="${dist.jar}" alias="jaer" keystore="keystore" storepass="jaerjaer"/>
    </target>
</project>
