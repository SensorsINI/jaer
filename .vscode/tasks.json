{
    // Ctrl+F5 → this "jAER: ant run" task. Cursor/VS Code do not load workspace
    // keybindings; once per computer:  ant install-jaer-run-shortcut
    "version": "2.0.0",
    "tasks": [
        {
            "label": "jAER: ant compile",
            "type": "shell",
            "command": "ant compile",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": false,
                "showReuseMessage": false
            },
            "problemMatcher": []
        },
        {
            "label": "jAER: ant run",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/run-jaer.sh",
            "windows": {
                "command": "${workspaceFolder}\\scripts\\run-jaer.bat"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": false,
                "showReuseMessage": false,
                "clear": false
            },
            "problemMatcher": []
        }
    ]
}
