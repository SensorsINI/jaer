<ivy-module version="2.0" xmlns:m="https://ant.apache.org/ivy/maven">
    <info organisation="org.jaerproject" module="jaer" />

    <dependencies>
        <!--see https://jogamp.org/wiki/index.php/Maven-->
        <!--see http://search.maven.org to find libraries -->
        <!--following does not work, since the latest jogl doesn't have com.jogamp.opengl--> 
        <!--<dependency org="org.jogamp.gluegen" name="gluegen-rt" rev="2.5.0" />-->
        <!--<dependency org="org.jogamp.gluegen" name="gluegen-rt-main" rev="2.5.0" />-->
        <!--jogl 2.5.0 is currently statically included as a fat jar in the jars folder.-->
        <!--<dependency org="org.jogamp.jogl" name="jogl-all-main" rev="2.5.0" />--> 
 
        <dependency org="org.swinglabs" name="swing-layout" rev="1.0.3" />
        <dependency org="org.jdesktop" name="beansbinding" rev="1.2.1" />

        <!--bag-reader-java-1.9.0 is here to obtain all of its dependencies, but we are using the fork at https://github.com/tobidelbruck/bag-reader-java currently-->
        <!--since our fixes were pulled, we can now use bag-reader-java 1.10.x-->
        <dependency org="com.github.swri-robotics" name="bag-reader-java" rev="1.10.0" />

        <!-- Code uses commons-math3 (DescriptiveStatistics, geometry, …). Do not rely on
             Ivy test-scope leakage from commons-text for this. -->
        <dependency org="org.apache.commons" name="commons-math3" rev="3.6.1"/>
        <!-- https://mvnrepository.com/artifact/commons-io/commons-io -->
        <dependency org="commons-io" name="commons-io" rev="2.15.1"/>
        <!--https://mvnrepository.com/artifact/org.apache.commons/commons-text-->
        <!-- Used only for WordUtils. GraalJS is a commons-text *test* dep that Ivy wrongly
             pulls into default (~60MB js+truffle); exclude it. -->
        <dependency org="org.apache.commons" name="commons-text" rev="1.11.0">
            <exclude org="org.graalvm.js" module="*"/>
            <exclude org="org.graalvm.truffle" module="*"/>
            <exclude org="org.graalvm.sdk" module="*"/>
            <exclude org="org.graalvm.regex" module="*"/>
        </dependency>
        <!-- https://mvnrepository.com/artifact/org.apache.commons/commons-collections4 -->
        <dependency org="org.apache.commons" name="commons-collections4" rev="4.4"/>

        <dependency org="com.google.code.gson" name="gson" rev="2.8.2" />

        <!-- AEDAT-4 FlatBuffers (DV-compatible) -->
        <dependency org="com.google.flatbuffers" name="flatbuffers-java" rev="23.5.26" />
        <!-- AEDAT-4 LZ4:
             * Write: lz4-java (native, independent blocks) — needed for live high-rate logging (NRV).
             * Read:  commons-compress framed LZ4 — supports DV dependent-block frames that lz4-java rejects.
             Overrides older commons-compress pulled transitively (e.g. bag-reader → 1.10).
             Ivy maps Maven test/optional deps into default — exclude them (same issue as zstd-jni). -->
        <dependency org="org.lz4" name="lz4-java" rev="1.8.0" />
        <dependency org="org.apache.commons" name="commons-compress" rev="1.26.2">
            <!-- optional compressors we do not use (AEDAT-4 ZSTD goes through zstd-jni directly) -->
            <exclude org="com.github.luben" module="zstd-jni"/>
            <exclude org="org.tukaani" module="xz"/>
            <exclude org="org.brotli" module="dec"/>
            <exclude org="org.ow2.asm" module="asm"/>
            <!-- test / OSGi integration (must not land on runtime classpath) -->
            <exclude org="org.junit.jupiter" module="*"/>
            <exclude org="org.junit.vintage" module="*"/>
            <exclude org="org.junit.platform" module="*"/>
            <exclude org="org.hamcrest" module="hamcrest"/>
            <exclude org="org.mockito" module="*"/>
            <exclude org="com.github.marschall" module="memoryfilesystem"/>
            <exclude org="org.ops4j.pax.exam" module="*"/>
            <exclude org="org.ops4j.pax.url" module="*"/>
            <exclude org="org.ops4j.pax.swissbox" module="*"/>
            <exclude org="org.ops4j.base" module="*"/>
            <exclude org="org.apache.felix" module="*"/>
            <exclude org="org.osgi" module="*"/>
            <exclude org="biz.aQute.bnd" module="*"/>
            <exclude org="org.ops4j.pax.tinybundles" module="tinybundles"/>
            <exclude org="org.slf4j" module="slf4j-api"/>
            <exclude org="org.slf4j" module="jcl-over-slf4j"/>
            <exclude org="javax.inject" module="javax.inject"/>
            <exclude org="org.codehaus.mojo" module="animal-sniffer-annotations"/>
        </dependency>
        <!-- zstd-jni declares scalatest as a *test* dependency; Ivy maps it into default
             (~19MB scala-library + scalatest*). Exclude — JNI jar alone is enough. -->
        <dependency org="com.github.luben" name="zstd-jni" rev="1.5.5-11">
            <exclude org="org.scalatest" module="*"/>
            <exclude org="org.scalatestplus" module="*"/>
            <exclude org="org.scalacheck" module="*"/>
            <exclude org="org.scalactic" module="*"/>
            <exclude org="org.scala-lang" module="*"/>
            <exclude org="org.scala-lang.modules" module="*"/>
            <exclude org="org.scala-sbt" module="*"/>
        </dependency>

        <!-- Pure-Java HDF5 (DSEC events.h5 playback). Blosc+ZSTD chunks use our BloscHdf5Filter + zstd-jni. -->
        <dependency org="io.jhdf" name="jhdf" rev="0.12.0">
            <!-- jHDF pulls at.yawk.lz4; we already ship org.lz4:lz4-java for AEDAT-4. -->
            <exclude org="at.yawk.lz4" module="lz4-java"/>
            <exclude org="org.lz4" module="lz4-java"/>
        </dependency>
        <!-- jHDF runtime; keep explicit so Ivy does not drop it via weird scopes. -->
        <dependency org="org.slf4j" name="slf4j-api" rev="2.0.16"/>
        <dependency org="org.apache.commons" name="commons-lang3" rev="3.17.0"/>

        <!-- Required by tensorflow-core-native (omitted when that dep is transitive=false). -->
        <dependency org="org.bytedeco" name="javacpp" rev="1.5.10" />

        <dependency org="com.neuronrobotics" name="nrjavaserial" rev="3.13.0" />
        <dependency org="com.kitfox.svg" name="svg-salamander" rev="1.0" />
        <dependency org="org.tallison" name="jmatio" rev="1.2" />
        <!--
        libusb not obtained from maven because there is no artifcact for Mac osx darwin (M1 apple silicon)
        Instead tobi obtained it separately from https://github.com/marian-m12l/studio/issues/244 and combined with jar download
        of libusb4java release
        -->

        <!--following is for the official org.opencv.core classes from nu.pattern, forked to org.openpnp now

        It is important to read https://github.com/openpnp/opencv to see how the OpenCV native libraries must be loaded to the JVM!

        This OpenCV is used by SingleCameraCalibration at least.

        -->
        <dependency org="org.openpnp" name="opencv" rev="4.8.1-0" />

        <!-- TensorFlow for MLPNoiseFilter — roles:
             * Ivy: tensorflow-core-api (+ transitives) and unclassified native stub only.
               Exclude classifier natives that Ivy would otherwise resolve via ${native.classifier}.
             * install4j: excludes any leftover OS classifier jars (safety net).
             * Runtime: TensorFlowNativeSupport downloads current-OS classifier jar on demand. -->
        <!-- See https://github.com/tensorflow/java -->
        <dependency org="org.tensorflow" name="tensorflow-core-api" rev="1.0.0-rc.2">
            <exclude org="org.tensorflow" module="tensorflow-core-native"/>
        </dependency>
        <!-- Force unclassified stub jar (Maven URL); Ivy+POM otherwise picks a bogus OS classifier.
             transitive=false avoids OS natives; javacpp is declared explicitly above. -->
        <dependency org="org.tensorflow" name="tensorflow-core-native" rev="1.0.0-rc.2" transitive="false">
            <artifact name="tensorflow-core-native" type="jar" ext="jar"
                       url="https://repo1.maven.org/maven2/org/tensorflow/tensorflow-core-native/1.0.0-rc.2/tensorflow-core-native-1.0.0-rc.2.jar"/>
        </dependency>
        <!-- protobuf was previously pulled via tensorflow-core-native transitives; keep it explicit for compile. -->
        <dependency org="com.google.protobuf" name="protobuf-java" rev="3.21.9" />
        <!-- Avoid: tensorflow-core-platform (every OS native, ~600MB). -->

        <!--for reading yaml files that store the input format for tensorflow graphs, e.g. cnns. Also for reading OpenCV Mat files in YamlMatLoader -->
        <dependency org="com.esotericsoftware.yamlbeans" name="yamlbeans" rev="1.17" />

        <!--mathematics, linear algebra and optimisation java library-->
        <dependency org="org.ojalgo" name="ojalgo" rev="44.0.0" />
        <!--used in telluride for communicating to foosball-->
        <dependency org="redis.clients" name="jedis" rev="2.9.0" />

        <!-- https://mvnrepository.com/artifact/org.eclipse.jgit/org.eclipse.jgit -->
        <dependency org="org.eclipse.jgit" name="org.eclipse.jgit" rev="5.7.0.202003110725-r" />

        <!-- for rebuild myself task in JaerUpdater -->
        <dependency org="org.apache.ant" name="ant-commons-net" rev="1.10.8" />

        <!-- used for numpy data file format npy and npz support in JVM -->
        <dependency org="org.jetbrains.bio" name="npy" rev="0.3.5"/>

        <!-- https://github.com/sh0nk/matplotlib4j -->
        <dependency org="com.github.sh0nk" name="matplotlib4j" rev="0.5.0" />

        <dependency org="joda-time" name="joda-time" rev="2.10.6">
            <artifact name="joda-time" type="jar" />
        </dependency>

        <dependency org="com.install4j" name="install4j-runtime" rev="10.0.6" />

    </dependencies>
</ivy-module>

